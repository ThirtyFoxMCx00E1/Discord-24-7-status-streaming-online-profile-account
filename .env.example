# Local testing only: copy to .env (or export these). NEVER commit your real token.
TOKEN=
# Your numeric Discord user ID (Discord > Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID).
# When set, the bot refuses to start if TOKEN belongs to a different account.
DISCORD_USER_ID=
YT_CHANNEL_URL=https://www.youtube.com/@yourhandle
# Optional:
# APPLICATION_ID=               (17-20 digit Application ID from discord.com/developers/applications)
# BUTTONS=watch,subscribe        (any two of: watch, subscribe, join)
# VIDEO_URL=https://www.youtube.com/watch?v=feeQHBrvLiE
# STATUS=idle
# TIMEZONE=Asia/Manila
# KEEPALIVE=1                    (only on hosts that need an open web port, e.g. Replit)
